# ============================================================
# DropDeploy — Environment Variables (.env.local)
# ============================================================
# Copy this file to `.env.local` and fill in the values.

# --- NextAuth (GitHub OAuth) ---
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL  : http://localhost:3000
#   Callback URL  : http://localhost:3000/api/auth/callback/github
# (In production replace localhost with your deployed domain.)
AUTH_GITHUB_ID=              # e.g. Iv1.xxxxxxxxxxxxxxxx
AUTH_GITHUB_SECRET=          # e.g. xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- NextAuth secret ---
# Generate one with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=

# --- GitHub OAuth scopes (configure in your OAuth App) ---
# Make sure the app requests: read:user user:email repo
# (the `repo` scope is needed to let users create+publish repos to their
#  own account via the DropDeploy GitHub flow)